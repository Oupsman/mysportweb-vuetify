server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # FIT files and equipment pictures (the backend refuses pictures above 15 MB)
    client_max_body_size 50m;

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # an upload analyses the file and draws its thumbnail
        proxy_read_timeout 120s;
    }

    location /MEDIA/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
    }

    # the file names of the built assets change with their content
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # the app: hash history, every page is index.html
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
