server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # FIT files and equipment pictures (the backend refuses pictures above 15 MB)
    client_max_body_size 50m;

    # The address of the backend is looked up at each request (cached 10 s) from the DNS of Docker, not once at
    # the start: a backend restarted or recreated gets another address, the old one gave 502 until the frontend
    # was restarted. NGINX_LOCAL_RESOLVERS: set by the entrypoint of the nginx image (see the Dockerfile).
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $backend ${BACKEND_URL};

    # What the pages may load: the app and the API from this origin, the map tiles from OpenStreetMap; styles
    # inline (Vuetify, Leaflet and Chart.js set style attributes), no inline script. Not in a frame.
    set $csp "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.tile.openstreetmap.org; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'";

    # The security headers, repeated in the locations below with an add_header of their own: nginx drops the
    # add_header of the server in a location that has one.
    # CSP_HEADER: Content-Security-Policy (default) blocks what the policy doesn't allow;
    # Content-Security-Policy-Report-Only only reports it in the console of the browser.
    add_header ${CSP_HEADER} $csp always;
    # HTTPS only for 180 days once a page came over HTTPS (ignored over HTTP)
    add_header Strict-Transport-Security "max-age=15552000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;

    location /api/ {
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # an upload analyses the file and draws its thumbnail
        proxy_read_timeout 120s;
    }

    # The import of the zip of an export: up to IMPORT_MAX_SIZE (the one of the backend, 2g by default), sent on
    # to the backend as it comes instead of being written to the disk of nginx first
    location = /api/v1/user/import {
        client_max_body_size ${IMPORT_MAX_SIZE};
        proxy_request_buffering off;
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # the backend checks the zip once it has it all
        proxy_read_timeout 300s;
    }

    location /MEDIA/ {
        proxy_pass $backend;
        proxy_set_header Host $host;
    }

    # the file names of the built assets change with their content
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header ${CSP_HEADER} $csp always;
        add_header Strict-Transport-Security "max-age=15552000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    }

    # the app: hash history, every page is index.html
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        add_header ${CSP_HEADER} $csp always;
        add_header Strict-Transport-Security "max-age=15552000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    }
}
